{
  "description": "Локальный советник glm-router. Не переключает модель сессии.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/glm-router-hook.mjs"],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/glm-router-hook.mjs"],
            "timeoutMs": 5000
          }
        ]
      }
    ]
  }
}
